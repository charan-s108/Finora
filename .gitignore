# =============================================================================
# Finora — .gitignore
# =============================================================================

# ── Environment (never commit — contains real API keys) ───────────────────────
finora-backend/.env
finora-frontend/.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# ── Data & Models (large — regenerate via scripts) ───────────────────────────
finora-backend/data/hf_cache/
finora-backend/data/qdrant/
finora-backend/data/bm25_index/
# finora-backend/data/universe/stocks.json is committed (105KB, baked into Docker)
*.bin
*.safetensors
*.onnx

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
finora-frontend/.next/
finora-frontend/out/
finora-frontend/.vercel/
*.tsbuildinfo

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── Eval outputs ──────────────────────────────────────────────────────────────
backend/data/eval_results/*.json

# ── Secrets ───────────────────────────────────────────────────────────────────
*.pem
*.key
*.p12

# ── Claude Code (internal architecture spec — not for public repo) ─────────────
CLAUDE.md

# ── Test outputs ──────────────────────────────────────────────────────────────
tests/stress_report.txt
tests/backend/stress/__pycache__/
tests/backend/unit/__pycache__/
tests/backend/integration/__pycache__/
