# =============================================================================
# FINORA FRONTEND — Environment Variables Template
# Copy this file to .env and fill in your values:  cp .env.example .env
# Production: set all these in Vercel dashboard instead of this file
# =============================================================================

# ── Backend URL ───────────────────────────────────────────────────────────────
# Server-side only (not in client JS bundle) — point to your Railway backend URL in prod
BACKEND_URL=http://localhost:7860
# Client-side (baked into browser JS at build time) — same URL as above
NEXT_PUBLIC_BACKEND_URL=http://localhost:7860

# ── App Identity ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Finora
NEXT_PUBLIC_APP_VERSION=1.0.0
